                   intro z
                   rw [hA,he]
                 · obtain ⟨r,hr,hrnorm,hrformula⟩ := actual_reflection_disk_extension
                   have hl : r left=left := by
                     apply Subtype.ext
                     rw [hrformula,hleft]
                     simp
                   have hright' : r right=right := by
                     apply Subtype.ext
                     rw [hrformula,hright]
                     simp
                   refine ⟨r.trans e,?_,?_,?_,?_⟩
