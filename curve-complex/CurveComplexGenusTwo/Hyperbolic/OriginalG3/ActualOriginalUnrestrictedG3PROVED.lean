         rw [hd2local k x hxloc.1 hxloc.2.1,← hTimage k x hxloc.1]
         exact hm (e k x) hxloc.2.2
   
     obtain ⟨d,hd,ht⟩ := position_extend_transverse_family E Unit (fun _ => a) (by intro i j hij; exact False.elim (hij (Subsingleton.elim _ _))) b
     obtain ⟨K,hKimage⟩ := (Quotient.exact hd.symm : (essentialCurveSetoid E).r b d)
     obtain ⟨e,he⟩ := K.homeomorphism_at (1 : Interval)
     have hef : ∀ x, e x = K.finalMap x := he
     let c : Curve E := ⟨e ∘ b.val.map,e.isEmbedding.comp b.val.embedded⟩
     have hcimage : c.image = d.val.image := by
       change Set.range (e ∘ b.val.map) = d.val.image
       rw [Set.range_comp]
       exact (Set.image_congr (fun x _ => hef x)).trans hKimage
     have hbc : AmbientIsotopy.Rel b.val.image c.image := ⟨K,hKimage.trans hcimage.symm⟩
     let c' : EssentialCurve E := ⟨c,(essential_isotopy_invariant hbc).mp b.property⟩
     have hclass : Quotient.mk (essentialCurveSetoid E) c' =
         Quotient.mk (essentialCurveSetoid E) b := (Quotient.sound hbc).symm
     have htrans : Transverse a.val c := by
       simpa only [Transverse,CrossesAt,hcimage] using ht ()
     refine ⟨c',hclass,htrans,hbc,?_⟩
     refine ⟨⟨fun zt => K.map (zt.2,b.val.map zt.1),
       K.map.continuous.comp (continuous_snd.prodMk
         (b.val.embedded.continuous.comp continuous_fst))⟩,?_,?_⟩
     · intro z
       exact K.at_zero (b.val.map z)
     · intro z
       exact (hef (b.val.map z)).symm
   have hfinite (n : ℕ) : ∀ a b : Curve E, Essential a → Essential b →
       FreeHomotopic ⟨a.map,a.embedded.continuous⟩ ⟨b.map,b.embedded.continuous⟩ →
       Transverse a b → (a.image ∩ b.image).ncard=n → AmbientIsotopy.Rel a.image b.image := by
     induction n using Nat.strong_induction_on with
     | h n ih =>
       intro a b ha hb hhom ht hn
       by_cases hz : n=0
       · exact hzero H a b ha hb hhom ht (hn.trans hz)
       by_cases ho : n=1
       · obtain ⟨x,α,β,hcross,hunique,hα,hβ⟩ := hphases a b ht (hn.trans ho)
         exact hsingleton H a b ha hb hhom x hcross hunique α β hα hβ
       have htwo : 2 ≤ (a.image ∩ b.image).ncard := by omega
       obtain ⟨K,L,c,d,hc,hd,hce,hde,htcd,hlt,hhomcd⟩ := hdrop H a b ha hb hhom ht htwo
       have hlt' : (c.image ∩ d.image).ncard<n := by simpa [hn] using hlt
       have hcd := ih (c.image ∩ d.image).ncard hlt' c d hce hde hhomcd htcd rfl
       have hac : AmbientIsotopy.Rel a.image c.image := by
         refine ⟨K,?_⟩
         change K.finalMap '' Set.range a.map=Set.range c.map
         rw [hc,Set.range_comp]
       have hbd : AmbientIsotopy.Rel b.image d.image := by
         refine ⟨L,?_⟩
         change L.finalMap '' Set.range b.map=Set.range d.map
         rw [hd,Set.range_comp]
       exact ambientIsotopy_equivalence.trans hac
         (ambientIsotopy_equivalence.trans hcd (ambientIsotopy_equivalence.symm hbd))
   let ae : EssentialCurve E := ⟨a,ha⟩
   let be : EssentialCurve E := ⟨b,hb⟩
   obtain ⟨d,_,ht,hbd,hhom_bd⟩ := hposition H ae be
   have hiff (f g : C(Circle,E)) : FreeHomotopic f g ↔ f.Homotopic g := by
     constructor
     · rintro ⟨M,h0,h1⟩
       exact ⟨{ toFun := fun tx => M (tx.2,tx.1)
                continuous_toFun := M.continuous.comp (continuous_snd.prodMk continuous_fst)
                map_zero_left := h0
                map_one_left := h1 }⟩
     · rintro ⟨M⟩
       exact ⟨⟨fun tx => M (tx.2,tx.1),M.continuous.comp (continuous_snd.prodMk continuous_fst)⟩,
         M.map_zero_left,M.map_one_left⟩
   have hhom_ad : FreeHomotopic ⟨a.map,a.embedded.continuous⟩
       ⟨d.val.map,d.val.embedded.continuous⟩ :=
     (hiff _ _).mpr (((hiff _ _).mp hhom).trans ((hiff _ _).mp hhom_bd))
   have had := hfinite (a.image ∩ d.val.image).ncard a d.val ha d.property hhom_ad ht rfl
   exact ambientIsotopy_equivalence.trans had (ambientIsotopy_equivalence.symm hbd)

