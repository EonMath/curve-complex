                   have hd : star (((a-d:ℝ):ℂ)-Complex.I*((b+c:ℝ):ℂ))*1+
                       star (((a+d:ℝ):ℂ)+Complex.I*((b-c:ℝ):ℂ)) = 2*((a:ℂ)+Complex.I*(c:ℂ)) := by
                     simp only [star_add,star_sub,star_mul,Complex.star_def,Complex.conj_ofReal,Complex.conj_I]
