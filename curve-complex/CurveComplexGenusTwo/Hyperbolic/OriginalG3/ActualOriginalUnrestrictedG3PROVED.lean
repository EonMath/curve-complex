                     (∀ w : Metric.closedBall (0:ℂ) 1, ‖(e w:ℂ)‖ = ‖(w:ℂ)‖) ∧
                     (∀ w : Metric.closedBall (0:ℂ) 1, (e w:ℂ)=star (w:ℂ)) := by
                   let D := Metric.closedBall (0:ℂ) 1
                   let F : D → D := fun w => ⟨star (w:ℂ),by
