                       nlinarith [norm_nonneg (w:ℂ)]
                     · intro hn
                       have hF := hiff.mpr (by rw [hn]; norm_num)
                       nlinarith [norm_nonneg ((u*(w:ℂ)+v)/(star v*(w:ℂ)+star u))]
               
               
                 have actual_disk_plus_endpoint (a b c d : ℝ) :
                     let u : ℂ := ((a+d:ℝ):ℂ)+Complex.I*((b-c:ℝ):ℂ)
