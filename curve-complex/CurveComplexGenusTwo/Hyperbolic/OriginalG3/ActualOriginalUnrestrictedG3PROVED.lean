                 have hre (z : H2) : (h • z).re=z.re+(scale-1)*b := by
                   let y := (k*g)⁻¹ • z
                   have hy : (k*g) • y=z := smul_inv_smul _ _
                   have hzr : z.re=α*(scale*y.re)+b := by
                     rw [←hy,mul_smul,hkre,hgre]
                   change (((g*k)*(k*g)⁻¹) • z).re=_
                   rw [mul_smul]
                   change ((g*k) • y).re=_
                   rw [mul_smul,hgre,hkre,hzr]
                   ring
                 have him (z : H2) : (h • z).im=z.im := by
                   let y := (k*g)⁻¹ • z
                   have hy : (k*g) • y=z := smul_inv_smul _ _
                   have hzi : z.im=β*(scale*y.im) := by
                     rw [←hy,mul_smul,hkim,hgim]
                   change (((g*k)*(k*g)⁻¹) • z).im=_
                   rw [mul_smul]
                   change ((g*k) • y).im=_
                   rw [mul_smul,hgim,hkim,hzi]
                   ring
                 obtain ⟨hh,hb⟩ := htranslation ε hε hgap h ((scale-1)*b) hre him
                 have hb0 : b=0 := (mul_eq_zero.mp hb).resolve_left (sub_ne_zero.mpr hscale)
                 exact ⟨hb0,mul_inv_eq_one.mp hh⟩
               have hSL (A : SL(2,ℝ))
                   (hend : ((A 0 0:ℂ)-Complex.I*(A 1 0:ℂ))/((A 0 0:ℂ)+Complex.I*(A 1 0:ℂ))=1) :
                   A 1 0=0 ∧ A 1 1≠0 ∧ ∀ z : H2,
