                 · have hh := congrArg Complex.re hcoe
                   simpa only [Complex.add_re,Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,zero_mul,sub_zero,UpperHalfPlane.coe_re] using hh
                 · have hh := congrArg Complex.im hcoe
                   simpa only [Complex.add_im,Complex.mul_im,Complex.ofReal_re,Complex.ofReal_im,zero_mul,add_zero,UpperHalfPlane.coe_im] using hh
               have actual_translated_axis_dilation_or_glide (g : H2 ≃ᵢ H2) (L : ℝ)
                   (hperiod : ∀t : ℝ, g (verticalPath t)=verticalPath (t+L)) :
                   (∀z : H2, (g z).re=Real.exp L*z.re ∧ (g z).im=Real.exp L*z.im) ∨
