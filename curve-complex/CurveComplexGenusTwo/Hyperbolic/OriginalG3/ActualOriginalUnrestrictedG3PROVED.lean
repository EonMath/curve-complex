                   · intro w
                     rfl
               
                 obtain ⟨A,hA⟩ := axis_metric_isometry_mobius_or_antimobius g
                 obtain ⟨e,he,hboundary,hel,her⟩ := actual_sl_disk_endpoints A left right hleft hright
                 refine ⟨A,hA,?_⟩
                 rcases hA with hA | hA
