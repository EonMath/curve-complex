                     rw [hboundary,hrnorm]
                   · simpa only [Homeomorph.trans_apply,hl] using hel
                   · simpa only [Homeomorph.trans_apply,hright'] using her
               have hcomm {G : Type} [Group G] [MulAction G H2]
                   (ε : ℝ) (hε : 0<ε)
                   (hgap : ∀ h : G, h≠1 → ∀ z : H2, ε≤dist z (h • z))
                   (g k : G) (scale α β b : ℝ) (hscale : scale≠1)
                   (hgre : ∀ z : H2, (g • z).re=scale*z.re)
                   (hgim : ∀ z : H2, (g • z).im=scale*z.im)
                   (hkre : ∀ z : H2, (k • z).re=α*z.re+b)
                   (hkim : ∀ z : H2, (k • z).im=β*z.im) :
                   b=0 ∧ Commute g k := by
                 have htranslation {G : Type} [Group G] [MulAction G H2]
                     (ε : ℝ) (hε : 0<ε)
                     (hgap : ∀ h : G, h≠1 → ∀ z : H2, ε≤dist z (h • z))
                     (h : G) (c : ℝ)
                     (hre : ∀ z : H2, (h • z).re=z.re+c)
                     (him : ∀ z : H2, (h • z).im=z.im) : h=1 ∧ c=0 := by
                   let A : GL (Fin 2) ℝ := GeneralLinearGroup.mkOfDetNeZero !![1,c;0,1]
                     (by simp [Matrix.det_fin_two])
                   have hdet : A.val.det=1 := by simp [A,Matrix.det_fin_two,GeneralLinearGroup.mkOfDetNeZero]
                   have hAe (z : H2) : A • z=h • z := by
                     apply UpperHalfPlane.coe_injective
                     rw [UpperHalfPlane.coe_smul_of_det_pos (by rw [GeneralLinearGroup.val_det_apply,hdet]; norm_num)]
                     change ((1:ℂ)*(z:ℂ)+(c:ℂ))/((0:ℂ)*(z:ℂ)+1)=(h • z: H2).coe
                     simp only [one_mul,zero_mul,zero_add,div_one]
                     apply Complex.ext
                     · simpa only [Complex.add_re,Complex.ofReal_re,UpperHalfPlane.coe_re] using (hre z).symm
                     · simpa only [Complex.add_im,Complex.ofReal_im,add_zero,UpperHalfPlane.coe_im] using (him z).symm
                   have hh : h=1 := by
                     by_contra hn
                     have hd := axis_uniform_gl_discriminant_pos A ε hε
                       (fun z => by rw [hAe]; exact hgap h hn z)
                     have hzero : A.val.discr=0 := by
                       norm_num [A,GeneralLinearGroup.mkOfDetNeZero,Matrix.discr_fin_two,Matrix.det_fin_two,Matrix.trace_fin_two]
                     rw [hzero] at hd
                     exact (lt_irrefl (0:ℝ)) hd
                   refine ⟨hh,?_⟩
                   have he := hre UpperHalfPlane.I
                   rw [hh,one_smul] at he
                   linarith
