                   rw [UpperHalfPlane.coe_specialLinearGroup_apply]
                   change ((A 0 0:ℂ)*(z:ℂ)+(A 0 1:ℂ))/((A 1 0:ℂ)*(z:ℂ)+(A 1 1:ℂ))=_
                   rw [hc]
                   push_cast
                   simp only [Complex.ofReal_zero,zero_mul,zero_add]
                   field_simp
