                       rw [hc,hre] at hdet
                       norm_num at hdet
                     have hz : (z:ℂ)+Complex.I ≠ 0 := by
                       intro h
                       have hh := congrArg Complex.im h
                       simp only [Complex.add_im,Complex.I_im,Complex.zero_im] at hh
                       change z.im+1 = 0 at hh
                       linarith [z.im_pos]
                     have hi := sl_cayley_intertwining (A 0 0) (A 0 1) (A 1 0) (A 1 1) (z:ℂ) hD hz
