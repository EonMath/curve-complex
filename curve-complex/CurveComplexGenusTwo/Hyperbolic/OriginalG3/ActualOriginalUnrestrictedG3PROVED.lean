                   · rw [he,hleft]
                     exact actual_disk_minus_endpoint _ _ _ _
                   · rw [he,hright]
                     exact actual_disk_plus_endpoint _ _ _ _
               
                 have actual_reflection_disk_extension : ∃ e : Metric.closedBall (0:ℂ) 1 ≃ₜ Metric.closedBall (0:ℂ) 1,
